{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ESNext",
		"lib": [
			"ESNext"
		],
		"types": [
			"node"
		],
		"paths": {
			"src/*": [
			  "./src/*"
			]
		},
		"noEmit": true,
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"src/**/*.ts",
		"eslint.config.ts"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
